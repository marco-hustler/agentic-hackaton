# --- idealo MCP ---
IDEALO_MCP_URL=https://mcp.idealo.com/mcp
IDEALO_COUNTRY=DE
IDEALO_OAUTH_CALLBACK_PORT=6274
IDEALO_TOKEN_FILE=.idealo_tokens.json
IDEALO_CACHE_DIR=data/cache

# --- idealo call budget (Trial tier: 500 calls/day, 3 calls/sec) ---
# Live idealo calls are OFF by default. Turn on only for a deliberate real test.
IDEALO_LIVE_ENABLED=false
# Local daily hard stop (keeps a reserve below idealo's 500/day).
IDEALO_DAILY_CALL_CAP=450
IDEALO_BUDGET_FILE=data/idealo_budget.json
# Cache expiry for per-tool idealo responses in seconds (0 = never expire, recommended for the event).
IDEALO_CACHE_TTL_SECONDS=0

# --- LLM (100% provider-agnostic via LiteLLM or OpenAI-compatible endpoint) ---
# Leave blank to run in deterministic no-LLM fallback mode (great for testing!).
# Examples:
#   LLM_MODEL=gemini/gemini-2.5-flash          (+ GEMINI_API_KEY)
#   LLM_MODEL=openai/gpt-4o-mini               (+ OPENAI_API_KEY)
#   LLM_MODEL=anthropic/claude-sonnet-4-5      (+ ANTHROPIC_API_KEY)
#   LLM_MODEL=openai/meta-llama/Meta-Llama-3.1-70B-Instruct  (+ LLM_API_KEY & LLM_API_BASE)
LLM_MODEL=
LLM_API_KEY=
LLM_API_BASE=

# Optional provider-specific keys read automatically by LiteLLM:
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
