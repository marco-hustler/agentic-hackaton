                  }
                ],
                "description": "Price per unit"
              },
              "shop": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "shopId": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "Shop ID"
                      },
                      "merchantId": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "Merchant ID"
                      },
                      "name": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
