[
  {
    "name": "search_products",
    "title": "Search catalog",
    "description": "Search idealo product catalog. Entry point for any product discovery flow.\n\nWHEN TO USE:\n- User asks to find / browse / look for / show products (\"find laptops\", \"show me running shoes\")\n- User refines a previous search (\"cheaper\", \"only Samsung\", \"under €500\", \"with feature X\") — re-call this tool with filter IDs from the prior response, not a new search\n\nRETURNS:\n- results: products with name, price, images, URLs, ratings, productRef\n- categories / manufacturers / filters / sizeAttributes / suggestedFilters: IDs + names you reuse to refine\n\nREFINEMENT LOOP:\n1. Broad query first (e.g. \"macbook\") to discover available category/brand/filter IDs.\n2. Re-call with includeCategories / includeManufacturers / includeSearchFilters using IDs from step 1.\n\nPair includeSearchFilters or includeSizeFilters with includeCategories (see server validation).\n\nStructured output: query, results (each with productRef), and optional availableCategories, availableManufacturers, availableFilters, sizeAttributes, suggestedFilters for refinement.",
    "input_schema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "description": "Natural-language product search terms (e.g. laptop, running shoes)."
        },
        "country": {
          "description": "Marketplace: DE (Germany), AT (Austria), GB or UK (United Kingdom), FR (France), IT (Italy), ES (Spain). An omitted or unknown code uses Germany.",
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "filters": {
          "description": "Optional refinements for price, availability, deals, category, brand, attributes, or size. IDs come from fields on a previous search response.",
          "type": "object",
          "properties": {
            "minPrice": {
              "description": "Lower price bound in EUR (for example 50 for €50). The server converts this value to cents.",
              "type": "number"
            },
            "maxPrice": {
              "description": "Upper price bound in EUR (for example 200 for €200). The server converts this value to cents.",
              "type": "number"
            },
            "availableOnly": {
              "description": "Set to true to show only products currently available for purchase (in stock). Use this when the user wants to see only products they can buy immediately, excluding out-of-stock items. Default is false (shows all products).",
              "type": "boolean"
            },
            "bargainsOnly": {
              "description": "Set to true to show only products with special discounts or price drops (bargains/deals). Use this when the user is specifically looking for discounted products, special offers, or the best deals. Default is false (shows all products).",
              "type": "boolean"
            },
            "includeCategories": {
              "description": "Category IDs from a prior response `availableCategories` entry. Required whenever you pass attribute or size filter IDs.",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\d+$"
              }
            },
            "includeManufacturers": {
              "description": "Manufacturer IDs from a prior response `availableManufacturers` entry to limit results to selected brands.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "includeSearchFilters": {
              "description": "Attribute filter IDs from `availableFilters` (color, material, etc.). Use `includeSizeFilters` for sizes. Pair with `includeCategories`.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "includeSizeFilters": {
              "description": "Size filter IDs from `sizeAttributes` (`attributeKeyValue` values). Pair with `includeCategories`.",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "query"
      ]
    },
    "execution": null,
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Echo of the submitted search query"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productRef": {
                "type": "string",
                "description": "Pass to get_product_details, get_product_offers, get_product_price_history"
              },
              "itemType": {
                "type": "string",
                "description": "PRODUCT, CLUSTER, or SINGLE_OFFER — use as `type` on follow-up calls when needed"
              },
              "siteId": {
                "type": "number",
                "description": "Internal marketplace id for the hit"
              },
              "name": {
                "type": "string",
                "description": "Display title of the product"
              },
              "nameDelta": {
                "description": "Variant or configuration suffix when present",
                "type": "string"
              },
              "price": {
                "description": "Best listed price when available",
                "type": "string"
              },
              "imageUrl": {
                "type": "string",
                "description": "Primary product image URL"
              },
              "url": {
                "description": "idealo product or offer page URL",
                "type": "string"
              },
              "totalOfferCount": {
                "description": "Number of shop offers aggregated for the product",
                "type": "number"
              },
              "badges": {
                "description": "Deal or highlight badges (e.g. bargain)"
              },
              "userReviewsSummary": {
                "description": "Aggregate user rating summary when present"
              },
              "testReportsSummary": {
                "description": "Expert test report summary when present"
              }
            },
            "required": [
              "productRef",
              "itemType",
              "siteId",
              "name",
              "imageUrl"
            ],
            "additionalProperties": false
          },
          "description": "Matching catalog items for the query and filters"
        },
        "availableCategories": {
          "description": "Categories in this result set — use categoryId values in includeCategories"
        },
        "availableManufacturers": {
          "description": "Brands in this result set — use manufacturerId in includeManufacturers"
        },
        "availableFilters": {
          "description": "Grouped attribute filters — use filterId in includeSearchFilters"
        },
        "sizeAttributes": {
          "description": "Grouped size options — use attributeKeyValue in includeSizeFilters"
        },
        "suggestedFilters": {
          "description": "Suggested next filters based on the query"
        },
        "searchResultsUrl": {
          "type": "string"
        }
      },
      "required": [
        "query",
        "results"
      ],
      "additionalProperties": false
    },
    "icons": null,
    "annotations": {
      "title": null,
      "read_only_hint": true,
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": true
    },
    "meta": null
  },
  {
    "name": "get_product_details",
    "title": "Product details",
    "description": "Get full product page data for a single product.\n\nWHEN TO USE:\n- User asks \"tell me about\", \"details on\", \"specs of\", \"reviews of\" a specific product\n- User picked one item from search_products results and wants depth\n\nRETURNS:\n- name, images, URL, specifications, overview\n- up to 3 preview offers (shop, price, delivery)\n- user review summary with rating distribution\n- expert test reports + idealo expert review\n- category-level pros / cons\n- 30-day price trend snippet (for chart-style preview)\n\nStructured output: single product object (name, images, specs, preview offers, reviews, pros/cons, optional priceTrend snippet). Use get_product_offers for all shops or get_product_price_history for full trend.",
    "input_schema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "productRef": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque productRef from search_products. It identifies the item. The marketplace comes from country."
        },
        "country": {
          "description": "Marketplace: DE (Germany), AT (Austria), GB or UK (United Kingdom), FR (France), IT (Italy), ES (Spain). An omitted or unknown code uses Germany.",
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "type": {
          "description": "Catalog item shape from search result `itemType`. Omit unless you need CLUSTER or SINGLE_OFFER.",
          "type": "string",
          "enum": [
            "CLUSTER",
            "PRODUCT",
            "SINGLE_OFFER"
          ]
        }
      },
      "required": [
        "productRef"
      ]
    },
    "execution": null,
